# ====================================================================
# TEMPLATE BIẾN MÔI TRƯỜNG ỨNG DỤNG (ENVIRONMENT CONFIGURATION)
# Hướng dẫn: Sao chép tệp này thành .env và điền các giá trị thực tế của bạn:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# LƯU Ý: KHÔNG ĐƯỢC COMMIT TỆP .env CHỨA KHÓA THẬT LÊN GIT!
# ====================================================================

# 1. Cấu hình Cổng Dịch Vụ Ứng Dụng
PORT=5000

# 2. Khóa Bí Mật Cho Session & JSON Web Token (JWT)
SECRET_KEY=your_secret_key_for_flask_session_here
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# 3. Chuỗi Kết Nối / Đường Dẫn Cơ Sở Dữ Liệu
# Sử dụng SQLite:
DB_PATH=database/salon_hair.db
DATABASE_URL=sqlite:///database/salon_hair.db

# 4. Cấu Hình Khóa Truy Cập Google Gemini Cloud AI
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# 5. Cấu Hình Máy Chủ AI Nội Bộ Ollama (Dự Phòng Zero-Downtime)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 6. Cấu Hình Tài Khoản Gửi Thư Tự Động (Gmail SMTP)
GMAIL_USER=your_email_address@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password_here
